# Upstream new-api instance (no trailing slash)
REMOTE_URL=https://your-newapi.example.com

# A token with admin rights on the upstream new-api
# Create a dedicated user account there rather than using a root token
REMOTE_ADMIN_TOKEN=sk-xxxxxxxxxxxxxxxxxxxx

# PostgreSQL DSN — same DB as report-service
DATABASE_URL=postgres://user:pass@localhost:5432/report_service?sslmode=require

# Must match JWT_SECRET used by report-service so tokens are interoperable
JWT_SECRET=change-me-to-match-report-service

# Bind address
LISTEN_ADDR=:8080

# "release" for production, "debug" for verbose gin output
GIN_MODE=release

# Path to new-api web build output (default: ../new-api/web/dist)
# WEB_DIST=/path/to/web/dist
