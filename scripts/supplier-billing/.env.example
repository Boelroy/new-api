# Dedicated service and database; do not reuse Report Service SQL_DSN or users.
BILLING_LISTEN=127.0.0.1:8092
# For a public deployment, set the exact browser HTTPS origin and remove the
# BILLING_ALLOW_LOCAL_HTTP line before recreating the service.
BILLING_ORIGIN=http://localhost:8092
BILLING_ALLOW_LOCAL_HTTP=true
BILLING_DB_DRIVER=postgres
BILLING_DB_DSN='host=127.0.0.1 port=5432 user=supplier_billing password=CHANGE_ME dbname=supplier_billing sslmode=disable'
BILLING_FRONTEND_DIR=./scripts/report-service/frontend-v3/dist-billing

# First start only. Set a unique password of 15–128 characters before starting.
BILLING_ADMIN_USERNAME=billing-manager
BILLING_ADMIN_PASSWORD=

# Allowed origins for read-only Report Service connectors (comma-separated).
BILLING_SOURCE_ORIGINS=
SUPPLIER_BILLING_SOURCE_DEV_TOKEN=
